# ── Data mode ─────────────────────────────────────────────────────────────
# mock = sample data served by this app (default, safe, no backend needed)
# live = every request goes to your n8n workflow through the server-side proxy
NEXT_PUBLIC_DATA_MODE=mock

# ── n8n (only used in live mode; read by the server, never sent to the browser) ──
# Base URL of the webhooks, e.g. https://your-instance.app.n8n.cloud/webhook   (use /webhook-test for test URLs)
N8N_BASE_URL=https://your-instance.app.n8n.cloud/webhook
# The Header Auth credential attached to the workflow's webhooks
N8N_WEBHOOK_AUTH_HEADER_NAME=X-Api-Key
N8N_WEBHOOK_AUTH_VALUE=change-me
# n8n Public API key. Only needed by developer tooling that reads the workflow (never by the running app).
N8N_API_KEY=

# ── Login ─────────────────────────────────────────────────────────────────
# Owner signs in with this password (min 12 characters recommended)
OWNER_PASSWORD=change-me-to-a-long-passphrase
# Consultants sign in with their email + a code derived from this seed (see Consultants page). Changing it rotates every code.
CONSULTANT_LOGIN_SEED=change-me-too
# Signs the httpOnly session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
